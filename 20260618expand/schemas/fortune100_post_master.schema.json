{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fortune 100 post master",
  "type": "object",
  "required": [
    "fortune_rank",
    "company_name",
    "source_x_handle",
    "tweet_id",
    "created_at",
    "text",
    "total_engagement",
    "log_total_engagement",
    "text_length",
    "hashtag_count",
    "mention_count",
    "source_folder"
  ],
  "properties": {
    "fortune_rank": {"type": ["integer", "string"]},
    "company_name": {"type": "string"},
    "normalized_company_name": {"type": "string"},
    "source_x_handle": {"type": "string"},
    "source_x_url": {"type": "string"},
    "account_role": {"type": "string"},
    "account_index": {"type": ["integer", "string"]},
    "tweet_id": {"type": "string"},
    "tweet_url": {"type": "string"},
    "created_at": {"type": "string"},
    "text": {"type": "string"},
    "reply_count": {"type": ["integer", "string"]},
    "repost_count": {"type": ["integer", "string"]},
    "retweet_count": {"type": ["integer", "string"]},
    "like_count": {"type": ["integer", "string"]},
    "favorite_count": {"type": ["integer", "string"]},
    "quote_count": {"type": ["integer", "string"]},
    "view_count_available": {"type": ["boolean", "string"]},
    "total_engagement": {"type": ["integer", "string"]},
    "log_total_engagement": {"type": ["number", "string"]},
    "text_length": {"type": ["integer", "string"]},
    "hashtag_count": {"type": ["integer", "string"]},
    "mention_count": {"type": ["integer", "string"]},
    "collection_method": {"type": "string"},
    "max_posts_cap": {"type": ["integer", "string"]},
    "source_folder": {"type": "string"}
  }
}
