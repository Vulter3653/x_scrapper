{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fortune 2025 Top 100 Human-Reviewed X Collection Queue Row",
  "description": "Schema for the future collection queue scaffold. The queue derives only from final_manual_scrape_eligible=true rows and does not authorize scraping.",
  "type": "object",
  "required": [
    "fortune_rank",
    "company_name",
    "normalized_company_name",
    "collection_x_handle",
    "collection_x_url",
    "secondary_x_url",
    "final_manual_account_status",
    "human_review_batch",
    "collection_status",
    "collection_authorized",
    "dry_run_only",
    "data_mutation_allowed",
    "dashboard_sync_allowed",
    "queue_source",
    "eligibility_source_field",
    "collection_priority",
    "collection_scope",
    "collection_start_policy",
    "collection_end_policy",
    "max_posts_policy",
    "notes"
  ],
  "properties": {
    "fortune_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "company_name": {
      "type": "string",
      "minLength": 1
    },
    "normalized_company_name": {
      "type": "string",
      "minLength": 1
    },
    "collection_x_handle": {
      "type": "string",
      "minLength": 1
    },
    "collection_x_url": {
      "type": "string",
      "minLength": 1
    },
    "secondary_x_url": {
      "type": "string"
    },
    "final_manual_account_status": {
      "type": "string",
      "enum": [
        "confirmed_candidate_official",
        "candidate_rejected_alternate_found"
      ]
    },
    "human_review_batch": {
      "type": "string",
      "minLength": 1
    },
    "collection_status": {
      "type": "string",
      "enum": [
        "queued_not_collected",
        "blocked",
        "collected",
        "failed"
      ]
    },
    "collection_authorized": {
      "type": "string",
      "enum": [
        "false"
      ]
    },
    "dry_run_only": {
      "type": "string",
      "enum": [
        "true"
      ]
    },
    "data_mutation_allowed": {
      "type": "string",
      "enum": [
        "false"
      ]
    },
    "dashboard_sync_allowed": {
      "type": "string",
      "enum": [
        "false"
      ]
    },
    "queue_source": {
      "type": "string",
      "enum": [
        "human_final_manual_review"
      ]
    },
    "eligibility_source_field": {
      "type": "string",
      "enum": [
        "final_manual_scrape_eligible"
      ]
    },
    "collection_priority": {
      "type": "string",
      "enum": [
        "top100_human_final"
      ]
    },
    "collection_scope": {
      "type": "string",
      "enum": [
        "timeline_posts_if_accessible"
      ]
    },
    "collection_start_policy": {
      "type": "string",
      "enum": [
        "to_be_defined_before_collection"
      ]
    },
    "collection_end_policy": {
      "type": "string",
      "enum": [
        "to_be_defined_before_collection"
      ]
    },
    "max_posts_policy": {
      "type": "string",
      "enum": [
        "to_be_defined_before_collection"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
