{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fortune Top 100 X Collection Readiness Policy",
  "description": "Dry-run-only readiness policy for the verified Fortune Top 100 X collection queue. This schema does not authorize scraping.",
  "type": "object",
  "required": [
    "policy_id",
    "queue_file",
    "eligible_account_count",
    "dry_run_only",
    "collection_authorized",
    "access_method",
    "mcp_required",
    "api_required",
    "browser_required",
    "rate_limit_policy",
    "max_posts_per_account",
    "date_window_policy",
    "retry_policy",
    "failure_status_values",
    "audit_log_required",
    "output_path_policy",
    "dashboard_sync_default",
    "data_mutation_allowed",
    "notes"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "enum": [
        "fortune_top100_verified_x_dry_run_v1"
      ]
    },
    "queue_file": {
      "type": "string",
      "enum": [
        "config/fortune2025_top100_verified_x_collection_queue.csv"
      ]
    },
    "eligible_account_count": {
      "type": "integer",
      "minimum": 0
    },
    "dry_run_only": {
      "type": "string",
      "enum": [
        "true"
      ]
    },
    "collection_authorized": {
      "type": "string",
      "enum": [
        "false"
      ]
    },
    "access_method": {
      "type": "string",
      "enum": [
        "to_be_decided"
      ]
    },
    "mcp_required": {
      "type": "string",
      "enum": [
        "to_be_decided"
      ]
    },
    "api_required": {
      "type": "string",
      "enum": [
        "to_be_decided"
      ]
    },
    "browser_required": {
      "type": "string",
      "enum": [
        "to_be_decided"
      ]
    },
    "rate_limit_policy": {
      "type": "string",
      "enum": [
        "to_be_defined_before_collection"
      ]
    },
    "max_posts_per_account": {
      "type": "string",
      "enum": [
        "to_be_defined_before_collection"
      ]
    },
    "date_window_policy": {
      "type": "string",
      "enum": [
        "to_be_defined_before_collection"
      ]
    },
    "retry_policy": {
      "type": "string",
      "enum": [
        "to_be_defined_before_collection"
      ]
    },
    "failure_status_values": {
      "type": "string"
    },
    "audit_log_required": {
      "type": "string",
      "enum": [
        "true"
      ]
    },
    "output_path_policy": {
      "type": "string",
      "enum": [
        "no_output_until_collection_authorized"
      ]
    },
    "dashboard_sync_default": {
      "type": "string",
      "enum": [
        "disabled"
      ]
    },
    "data_mutation_allowed": {
      "type": "string",
      "enum": [
        "false"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
