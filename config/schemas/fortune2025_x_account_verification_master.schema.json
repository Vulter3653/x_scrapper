{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fortune 2025 X Account Verification Master",
  "type": "object",
  "required": ["fortune_year", "fortune_rank", "firm_name", "official_x_account_status", "needs_manual_review"],
  "properties": {
    "fortune_year": {"type": "string"},
    "fortune_rank": {"type": "integer", "minimum": 1},
    "firm_name": {"type": "string", "minLength": 1},
    "entity_type": {"type": "string"},
    "fortune_company_url": {"type": "string"},
    "official_x_account_status": {"type": "string", "enum": ["unknown", "official", "not_found", "no_corporate_account", "ambiguous", "deprecated"]},
    "reviewed_x_handle": {"type": "string"},
    "reviewed_x_profile_url": {"type": "string"},
    "direct_x_handle_candidate": {"type": "string"},
    "direct_x_profile_url": {"type": "string"},
    "verification_sources": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_manual_review": {"type": "boolean"},
    "review_notes": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": true
}
