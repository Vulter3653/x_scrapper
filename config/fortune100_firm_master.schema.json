{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vulter3653/x_scrapper/config/fortune100_firm_master.schema.json",
  "title": "Fortune 100 Firm Master Row",
  "description": "Schema for a row in config/fortune100_firm_master.csv. The cohort is the latest accessible Fortune 500 ranking filtered to ranks 1 through 100.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "firm_id",
    "fortune_year",
    "fortune_rank",
    "firm_name",
    "fortune_company_url",
    "fortune_ranking_source_url",
    "country",
    "industry",
    "sector",
    "revenues_millions",
    "employees",
    "ticker",
    "exchange",
    "official_website",
    "x_handle",
    "x_profile_url",
    "x_user_id",
    "x_handle_source_url",
    "x_handle_source_type",
    "x_handle_confidence",
    "x_handle_verified_status",
    "include_flag",
    "exclusion_reason",
    "notes",
    "collected_at"
  ],
  "properties": {
    "firm_id": { "type": "string", "pattern": "^f[0-9]{4}_[0-9]{3}_[a-z0-9_]+$" },
    "fortune_year": { "type": "integer", "minimum": 2000 },
    "fortune_rank": { "type": "integer", "minimum": 1, "maximum": 100 },
    "firm_name": { "type": "string", "minLength": 1 },
    "fortune_company_url": { "type": "string" },
    "fortune_ranking_source_url": { "type": "string", "format": "uri" },
    "country": { "type": "string" },
    "industry": { "type": "string" },
    "sector": { "type": "string" },
    "revenues_millions": { "type": ["number", "string"] },
    "employees": { "type": ["integer", "string"] },
    "ticker": { "type": "string" },
    "exchange": { "type": "string" },
    "official_website": { "type": "string" },
    "x_handle": { "type": "string", "pattern": "^$|^@?[A-Za-z0-9_]{1,15}$" },
    "x_profile_url": { "type": "string" },
    "x_user_id": { "type": "string" },
    "x_handle_source_url": { "type": "string" },
    "x_handle_source_type": { "type": "string", "enum": ["", "company_website", "fortune_profile", "x_verified_profile", "press_page", "manual_review"] },
    "x_handle_confidence": { "type": "string", "enum": ["high", "medium", "low", "not_found"] },
    "x_handle_verified_status": { "type": "string", "enum": ["verified", "not_verified", "unknown"] },
    "include_flag": { "type": "integer", "enum": [0, 1] },
    "exclusion_reason": { "type": "string" },
    "notes": { "type": "string" },
    "collected_at": { "type": "string", "format": "date-time" }
  }
}
